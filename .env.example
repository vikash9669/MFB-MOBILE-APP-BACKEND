# MFB backend — environment template
#
# Every key below is one the code actually reads (derived from `process.env.*`
# across the repo). Copy to `.env` and fill in real values; never commit `.env`.
#
# Values here are placeholders only.

# ── Database ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mfb_legacy
DB_USER_NAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_STRING
JWT_REFRESH_SECRET_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING
# Guards the internal /notify/push and /delivery/admin/* routes.
ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_STRING

NODE_ENV=development

# ── Google Maps ──────────────────────────────────────────────────────
# Server-side key used by util/geo.js to geocode restaurant and customer
# addresses when a delivery job is created. Needs the *Geocoding API* enabled
# and must be restricted by IP (server key), NOT by Android/iOS app — the app
# keys will not work here and vice versa. Leave blank and delivery jobs are
# still created, just with no coordinates and no distance-based pay/matching.
GOOGLE_MAPS_API_KEY=

# ── Delivery dispatch ────────────────────────────────────────────────
# Rider pay per job: base fare, per-km rate, and the distance included in the
# base before per-km pay starts.
DELIVERY_EARN_BASE=25
DELIVERY_EARN_PER_KM=6
DELIVERY_EARN_FREE_KM=2
# Furthest a rider will be offered a pickup from their last known position.
DELIVERY_MAX_OFFER_KM=8
# OFF unless this is exactly "true". Setting it seeds fabricated orders,
# earnings and a pre-approved KYC status onto a partner's FIRST login, and
# bypasses the onboarding gate — dev only, never on a deployment real riders
# log into. See util/deliveryDemo.js.
DELIVERY_DEMO=false

# ── OTP ──────────────────────────────────────────────────────────────
# Which provider util/otp.js dispatches to.
MSGPROVIDER=otpless
# Dev bypass: accept a fixed code instead of sending real SMS.
OTP_DEV_MODE=true
OTP_DEV_CODE=123456
OTP_DEV_NUMBERS=

OTPLESS_CLIENT_ID=REPLACE_ME
OTPLESS_CLIENT_SECRET=REPLACE_ME

MSG91_AUTH_KEY=REPLACE_ME
MSG91_SENDER_ID=REPLACE_ME
MSG91_TEMPLATE_ID=REPLACE_ME
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=10

TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_VERIFY_SERVICE_SID=REPLACE_ME

# ── Push (FCM HTTP v1) ───────────────────────────────────────────────
# From the Firebase service-account JSON. Keep the \n escapes in the key.
FCM_PROJECT_ID=REPLACE_ME
FCM_CLIENT_EMAIL=REPLACE_ME
FCM_PRIVATE_KEY=REPLACE_ME

# ── Email ────────────────────────────────────────────────────────────
EMAIL_HOST=REPLACE_ME
EMAIL_USER=REPLACE_ME
EMAIL_PASS=REPLACE_ME

# ── PhonePe ──────────────────────────────────────────────────────────
PHONEPE_ENV=SANDBOX
PHONEPE_MERCHANT_ID=REPLACE_ME
PHONEPE_CLIENT_ID=REPLACE_ME
PHONEPE_CLIENT_SECRET=REPLACE_ME
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=REPLACE_ME
PHONEPE_WEBHOOK_PASSWORD=REPLACE_ME


# ── Payment provider ─────────────────────────────────────────────────
# Which gateway takes money: phonepe | cashfree. Unset means phonepe, so an
# existing deployment keeps the behaviour it already had. Dispatched in
# util/gateway.js — no app or panel release is needed to switch, because both
# native SDKs ship in the mobile builds and the storefront branches on the
# `provider` field the initiate response carries.
PAYMENT_PROVIDER=cashfree
# How long one "payments charged with no order" alert silences the next
# identical one. The sweeper re-checks every minute and the host restarts
# often; without this window the same 3 stuck payments produced 70 identical
# notifications. Suppression does not clear the payments — they still need a
# human at store_payment_intents.
PAYMENT_STUCK_REALERT_HOURS=12


# ── Cashfree (util/cashfree.js) ──────────────────────────────────────
# Dashboard → Developers → API Keys. UAT uses the sandbox host, PROD the live
# one; the same two credentials authenticate every call (no OAuth step).
# The webhook is verified with CASHFREE_CLIENT_SECRET as the HMAC key, so there
# is no separate webhook credential to configure the way PhonePe needs one.
CASHFREE_ENV=UAT
CASHFREE_CLIENT_ID=REPLACE_ME
CASHFREE_CLIENT_SECRET=REPLACE_ME
# Doorstep UPI QR uses Cashfree's server-to-server endpoint, which is gated
# behind the S2S flag on the merchant account and is NOT granted by default.
# Leave this off until Cashfree confirms it is enabled: with it off, doorstep
# collection falls back to an ordinary checkout link and still works.
CASHFREE_S2S_ENABLED=false

# Public base URL of THIS backend, used to build the notify_url a gateway posts
# webhooks to. Must be reachable from the internet — on a host that is not, the
# reconciliation sweeper is the only thing that will ever settle a payment.
PUBLIC_API_URL=https://your-backend.example.com

# Where uploaded images are publicly served from. Used by util/assetUrl.js to
# turn a stored filename into the absolute URL that FCM's notification.image
# field requires — the pictures on order and promo notifications.
#
# This MUST be reachable from the public internet: FCM fetches the image from
# Google's servers, not from the device. The default is the local PHP host on
# :8091, which works for the panel and silently produces image-less
# notifications everywhere else, since FCM drops an image it cannot fetch.
ASSETS_BASE_URL=https://www.myfirstbite.in/assets/uploads

# ── Image uploads (util/uploadStore.js) ──────────────────────────────
# In development the PHP app is a sibling directory and these stay empty: the
# file is written straight to MFB_PHP_ADMIN_PANEL/admin/assets/uploads.
#
# On a DEPLOYED host the two are different machines, so the backend must ship
# the file to the PHP host over FTPS instead. Without these, a deployed host
# refuses uploads with 503 rather than writing into a container directory that
# nothing serves and the next restart deletes.
UPLOADS_FTP_HOST=
UPLOADS_FTP_USER=
UPLOADS_FTP_PASSWORD=
UPLOADS_FTP_PORT=21
UPLOADS_FTP_SECURE=true
UPLOADS_FTP_ROOT=public_html/assets/uploads
# Overrides the local path. Set this only if you know what the directory is —
# it is trusted even in production.
UPLOADS_ROOT=



# ── Rate limiting (middlewares/rateLimit.js) ─────────────────────────
# All optional. Unset keeps the built-in defaults, which are already ON.

# Set ONLY when something in front of Node rewrites X-Forwarded-For (nginx, a
# load balancer). Without it, every caller behind the proxy shares one bucket.
# With it set while nothing strips the header, a caller can name their own IP
# and mint a fresh allowance per request — worse than one shared bucket.
# "1" is right for a single proxy; "true" or "loopback" also work.
TRUST_PROXY=

# Emergency off switch for all of it. Unset means ON.
RATE_LIMIT_DISABLED=false

OTP_SEND_WINDOW_MIN=15
OTP_SEND_MAX_PER_PHONE=5
OTP_SEND_MAX_PER_IP=20

OTP_VERIFY_WINDOW_MIN=15
OTP_VERIFY_MAX=8

LOGIN_WINDOW_MIN=15
LOGIN_MAX_PER_ACCOUNT=8
LOGIN_MAX_PER_IP=30

REGISTER_WINDOW_MIN=60
REGISTER_MAX_PER_IP=5

ADMIN_KEY_WINDOW_MIN=15
ADMIN_KEY_MAX_FAILURES=10

DELIVERY_CODE_WINDOW_MIN=15
DELIVERY_CODE_MAX_FAILURES=10

REFRESH_WINDOW_MIN=15
REFRESH_MAX_PER_IP=60

PLACES_LOOKUP_WINDOW_MIN=10
PLACES_LOOKUP_MAX=120
PLACES_RATE_LIMIT=40

# ─── Rider application alerts ────────────────────────────────────────
# Fired when a delivery partner submits their application for review
# (controllers/deliveryOnboarding.js → util/adminNotify.js).
#
# RIDER_ALERT_CHANNELS — which channels tell admin staff. Comma-separated:
#   panel     a row in store_user_notifications, one per admin account, shown
#             in the panel's staff bell. Implies "realtime".
#   realtime  an SSE event, so an open panel updates without a refresh.
#   email     via the transport configured above.
#   sms       via Twilio Messaging, to ADMIN_ALERT_PHONES only.
# Defaults to "panel" when unset — email and SMS cost money and reach real
# people, so they are opt-in. Set to "none" to switch everything off.
#
# IMPORTANT: use the literal "none" to disable, never a blank value. A blank
# one means "unset, use the default", so that a field cleared in a hosting
# dashboard cannot silently switch off the durable panel notification.
RIDER_ALERT_CHANNELS=panel
# Who gets the mail. Narrow it to the people who actually review applications;
# without it every admin account gets one, which is slow and a good way to get
# an SMTP account rate-limited. Same idea as ORDER_ALERT_EMAILS.
RIDER_ALERT_EMAILS=
# Admin mobile numbers for the SMS channel — reuses the same explicit list the
# vendor escalations use, so there is one place that decides whose phone rings.
# ADMIN_ALERT_PHONES is defined above.

# RIDER_DECISION_CHANNELS — how a rider is told the outcome of their
# application (util/riderAlerts.js). Comma-separated: email, sms.
# Defaults to BOTH when unset: the rider is the person waiting on the answer,
# and neither channel can reach anyone who did not apply. The in-app
# notification is separate and always sent.
# NOTE: most riders have no real email — onboarding does not require one, so
# dp_email holds a generated dp<phone>@example.com placeholder, which is
# skipped rather than bounced. SMS is the channel that actually lands.
# Set to "none" to disable both and rely on the in-app notification alone.
RIDER_DECISION_CHANNELS=none

# ORDER_ESCALATION_CHANNELS — how admin staff are told that a vendor is sitting
# on an order, and that one was auto-cancelled (util/adminNotify.js).
# Comma-separated: panel, email, sms. Defaults to "panel" when unset.
#
# These two used to be email + WhatsApp unconditionally. They are gated rather
# than removed, so bringing the louder channels back for a busy period is an
# env change and not a deploy. "panel" implies the live SSE event as well.
ORDER_ESCALATION_CHANNELS=panel

# ── Acceptance ladder timings (util/orderAcceptSweeper.js) ──
# An order sits at "Received" until the vendor accepts it. These minute marks,
# measured from when the sweeper first sees the order, drive the escalation:
#
#   REMINDER_EVERY_MIN  vendor re-alerted on the active channels (WhatsApp/call)
#   ESCALATE_MIN        admin in-app ring + the vendor panel re-rings
#   EMAIL_ALL_MIN       email to BOTH vendor and admin, both panels re-alerted
#   CANCEL_MIN          order auto-cancelled and any online payment refunded
#
# All optional; the defaults below are also the code defaults. CANCEL_MIN also
# accepts the legacy name ORDER_ACCEPT_DEADLINE_MIN.
ORDER_ACCEPT_REMINDER_EVERY_MIN=2
ORDER_ACCEPT_ESCALATE_MIN=4
ORDER_ACCEPT_EMAIL_ALL_MIN=6
ORDER_ACCEPT_CANCEL_MIN=10
# Master kill-switch for the only step that moves money. "false" disables the
# auto-cancel while leaving every alert tier running.
ORDER_AUTO_CANCEL=true

# ── Rider dispatch (util/dispatch/*) ──
# DISPATCH_MODE picks how a delivery job reaches riders once the vendor accepts:
#   broadcast  offer to EVERY eligible rider within DISPATCH_BROADCAST_RADIUS_KM
#              at once; first to accept wins; re-broadcast every
#              DISPATCH_BROADCAST_TTL_SEC; at DISPATCH_ADMIN_ESCALATE_MIN with
#              nobody accepting, admin staff are alerted (bell + mail) and the
#              job appears in the panel's "processed but unassigned" section.
#   targeted   the original ranked, one-rider-at-a-time offer ladder (scoring,
#              expanding radius). Still available; not the default.
DISPATCH_MODE=broadcast
DISPATCH_BROADCAST_RADIUS_KM=15
DISPATCH_BROADCAST_TTL_SEC=120
DISPATCH_ADMIN_ESCALATE_MIN=4
# Start looking for a rider the moment the vendor accepts, rather than timing it
# to the prep estimate. On for the broadcast flow.
DISPATCH_IMMEDIATE=true
# Master switch: false = schedule and log but never offer (watch it think).
DISPATCH_ENABLED=true

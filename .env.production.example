# ══════════════════════════════════════════════════════════════════════
# RENDER DEPLOYMENT — environment
#
# On Render these are set in the dashboard (Environment → Environment
# Variables), not in a file. This is the checklist to work from.
#
# Three kinds of entry below:
#   <GENERATE>      make a NEW value — never reuse the local one
#   <COPY>          copy the value from your local .env, key for key
#   a literal value use it exactly as written
#
# Do NOT set PORT. Render injects it and app.js reads it.
# ══════════════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=production
# Exactly one proxy sits in front on Render. Without this every caller
# shares one rate-limit bucket, so one busy user exhausts everyone's.
TRUST_PROXY=1
# Render's free plan blocks outbound SMTP (25/465/587); the HTTPS API is
# also ~2x faster. SMTP stays wired for a server deployment.
EMAIL_TRANSPORT=api
# Creates the 18 delivery tables + 14 columns on the imported copy at
# first boot. Additive only.
AUTO_MIGRATE=true

# ─── Database — the COPY, never the production database ───────────────
# Hostinger hPanel → Remote MySQL. Use the dedicated user that has rights
# on the copy ONLY, so a mistake here cannot reach live data.
DB_HOST=<GENERATE — Hostinger MySQL host from Remote MySQL>
DB_PORT=3306
DB_NAME=<GENERATE — e.g. u635357561_MFB_NEW>
DB_USER_NAME=<GENERATE — the copy-only user>
DB_PASSWORD=<GENERATE — long and random>

# ─── Auth — MUST be new ───────────────────────────────────────────────
# The local values are the shipped defaults. Anyone who has seen this repo
# can mint tokens for any account with them. openssl rand -hex 32
JWT_SECRET_KEY=<GENERATE>
JWT_REFRESH_SECRET_KEY=<GENERATE>
# Guards /delivery/admin/* and /notify/push. openssl rand -hex 24
ADMIN_API_KEY=<GENERATE>

# ─── Where things live ────────────────────────────────────────────────
# Order emails link here — a wrong value makes every alert useless.
PANEL_URL=<GENERATE — https://your-panel-host>
# CORS allowlist. The panel cannot call the API without its exact origin.
# Comma-separated. Do not use *.
ADMIN_PANEL_ORIGINS=<GENERATE — https://your-panel-host>
STORE_URL=https://www.myfirstbite.in

# ─── Live-send allowlist — KEEP THIS SET FOR THIS DEPLOYMENT ──────────
# The imported copy contains 71 real vendors and ~20,000 real phone
# numbers. Without this, a test order texts an actual restaurant.
# Clear it only when the data is no longer real people.
LIVE_SEND_ALLOWLIST=<COPY>

# ─── SMS / WhatsApp / voice (Twilio) ──────────────────────────────────
MSGPROVIDER=twilio
TWILIO_ACCOUNT_SID=<COPY>
TWILIO_AUTH_TOKEN=<COPY>
TWILIO_VERIFY_SERVICE_SID=<COPY>
TWILIO_SMS_FROM=<COPY>
TWILIO_WHATSAPP_FROM=<COPY>
TWILIO_VOICE_FROM=<COPY>
# Empty until Meta approves the template. WhatsApp falls back to SMS.
TWILIO_WA_OTP_CONTENT_SID=
CUSTOMER_ALERT_CHANNELS=sms
VENDOR_ALERT_CHANNELS=sms
ADMIN_ALERT_PHONES=<COPY>

# ─── Email (SendGrid) ─────────────────────────────────────────────────
# EMAIL_PASS doubles as the API key when EMAIL_TRANSPORT=api.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_USER=apikey
EMAIL_PASS=<COPY>
EMAIL_FROM=orders@myfirstbite.in
ORDER_ALERT_EMAILS=<COPY>

# ─── Push (Firebase) ──────────────────────────────────────────────────
FCM_PROJECT_ID=mfbapp-a4312
FCM_CLIENT_EMAIL=<COPY>
# Paste with the \n escapes intact — Render's UI accepts multi-line, but
# the escaped single-line form is what util/fcm.js expects.
FCM_PRIVATE_KEY=<COPY>

# ─── Maps ─────────────────────────────────────────────────────────────
# Must have NO application restriction (or be IP-restricted). A
# referrer-restricted key fails every server-side call.
GOOGLE_MAPS_API_KEY=<COPY>

# ─── Payments (PhonePe) ───────────────────────────────────────────────
# UAT until KYC clears. No real money moves.
PHONEPE_ENV=UAT
PHONEPE_MERCHANT_ID=FIRSTBITEONLINE
PHONEPE_CLIENT_VERSION=1
PHONEPE_CLIENT_ID=<COPY>
PHONEPE_CLIENT_SECRET=<COPY>
PHONEPE_WEBHOOK_USERNAME=<COPY>
PHONEPE_WEBHOOK_PASSWORD=<COPY>

# ─── Storefront / dispatch behaviour ──────────────────────────────────
# One city for everyone: the app never sends a pincode.
DEFAULT_CITY_PINCODE=452010
# How long one rider holds an offer before it moves on.
DISPATCH_OFFER_TTL_SEC=180
# Test-tuned: vendor is chased after 1 minute, twice. Raise both to
# something humane (5-10) before real vendors are on the other end.
ORDER_ACCEPT_DEADLINE_MIN=1
ORDER_ACCEPT_REMINDER_EVERY_MIN=1
ORDER_ACCEPT_MAX_REMINDERS=2
ORDER_AUTO_CANCEL=false
DELIVERY_DEMO=false

# ─── OTP bypass — REMOVE BEFORE REAL USERS ────────────────────────────
OTP_DEV_MODE=false
OTP_DEV_CODE=123456
# These numbers skip OTP entirely and accept OTP_DEV_CODE. Fine while
# testing; a way in for anyone who reads this file once you are live.
OTP_DEV_NUMBERS=<COPY>

# ─── Rate limiting ────────────────────────────────────────────────────
# All optional — omitting them keeps the built-in defaults, which are the
# same values. Listed so the caps are visible rather than implicit.
RATE_LIMIT_DISABLED=false
OTP_SEND_WINDOW_MIN=15
OTP_SEND_MAX_PER_PHONE=5
OTP_SEND_MAX_PER_IP=20
OTP_VERIFY_WINDOW_MIN=15
OTP_VERIFY_MAX=8
LOGIN_WINDOW_MIN=15
LOGIN_MAX_PER_ACCOUNT=8
LOGIN_MAX_PER_IP=30
REGISTER_WINDOW_MIN=60
REGISTER_MAX_PER_IP=5
ADMIN_KEY_WINDOW_MIN=15
ADMIN_KEY_MAX_FAILURES=10
DELIVERY_CODE_WINDOW_MIN=15
DELIVERY_CODE_MAX_FAILURES=10
REFRESH_WINDOW_MIN=15
REFRESH_MAX_PER_IP=60
PLACES_LOOKUP_WINDOW_MIN=10
PLACES_LOOKUP_MAX=120
PLACES_RATE_LIMIT=40

# ─── Deliberately NOT set ─────────────────────────────────────────────
# PORT             Render injects it
# OTPLESS_*        unused; MSGPROVIDER=twilio
# MSG91_*          unused; kept wired as the India-native fallback

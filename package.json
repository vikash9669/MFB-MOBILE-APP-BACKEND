{
  "name": "mfb-mobile-app-backend",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "nodemon --env-file=.env app.js",
    "start": "node --env-file-if-exists=.env app.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "migrate:delivery": "node --env-file=.env scripts/migrate-delivery.js",
    "seed:delivery": "node --env-file=.env scripts/seed-delivery.js",
    "lint": "eslint ./",
    "test": "node --test \"test/**/*.test.js\"",
    "schema:check": "node --env-file-if-exists=.env scripts/schema.js",
    "schema:apply": "node --env-file-if-exists=.env scripts/schema.js --apply"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "basic-ftp": "^6.2.1",
    "express": "~4.16.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.9",
    "nodemailer": "^6.9.14",
    "sequelize": "^6.37.3",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "eslint": "^9.3.0",
    "globals": "^15.3.0",
    "nodemon": "^3.1.2",
    "sequelize-auto": "^0.8.8"
  }
}
